# Touchgrass release signing — local template.
#
# 1. Copy this file to `keystore.properties` (in the project root).
# 2. Fill in the real values below.
# 3. NEVER commit `keystore.properties` — it is gitignored.
#
# CI does not use this file. The `release.yml` workflow rebuilds it at runtime
# from GitHub Secrets (KEYSTORE_BASE64 → keysets/touchgrass-upload.jks,
# KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD). See docs/SPEC.md §8.4.

# Path to the keystore, resolved from the project root.
storeFile=keysets/keysets

# Keystore password (the one you typed when keytool generated the .jks).
storePassword=REPLACE_ME

# Alias inside the keystore. Inspect with:
#   keytool -list -keystore keysets/keysets
# (Likely `touchgrass` based on what's already inside.)
keyAlias=touchgrass

# Key password (often the same as storePassword for a PKCS12 keystore).
keyPassword=REPLACE_ME
